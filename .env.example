NEXT_PUBLIC_SITE_URL=https://covestro-polycarbonates.com
NEXT_PUBLIC_APP_VERSION=1.0.0
# Public contact overrides (optional — defaults in lib/site-config.ts)
# NEXT_PUBLIC_CONTACT_SALES_EMAIL=sales@yourdomain.com
# NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+1 (000) 000-0000
# NEXT_PUBLIC_CONTACT_PHONE_HREF=+10000000000
# Keep siteConfig.social.whatsapp in sync with the real E.164 number.
# Injected automatically by scripts/cf-deploy-tracked.mjs in production deploys
# NEXT_PUBLIC_GIT_SHA=abcdef123456
# NEXT_PUBLIC_BUILD_TIME=2026-04-21T18:30:00.000Z

# Email delivery (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Leads <no-reply@yourdomain.com>
RESEND_TO_EMAIL=sales@yourdomain.com
# Optional: admin quote/order alerts (falls back to RESEND_TO_EMAIL)
# ADMIN_NOTIFY_EMAIL=ops@yourdomain.com

# D1 database is bound in wrangler (not a URL here) — see wrangler.jsonc

# If `npm run verify` or `readiness:report` crashes during `next build` with OOM / bad_alloc / exit 134 on Windows,
# the go-readiness script defaults to READINESS_HEAP_MB=8192 for the verify child (tsc + next build), and
# strips prior --max-old-space-size from NODE_OPTIONS so that cap applies. Override e.g.:
# READINESS_HEAP_MB=12288
# READINESS_NODE_OPTIONS=--max-old-space-size=8192
# READINESS_HEAP_OFF=1

# CRM / webhook sink (optional)
# CRM_WEBHOOK_URL=https://your-crm-endpoint.example.com/leads
# CRM_WEBHOOK_BEARER_TOKEN=your_token_here

# Admin portal password (required — set a strong password before deploying)
ADMIN_PASSWORD=change-me-before-deploying

# Customer portal session secret (defaults to ADMIN_PASSWORD if not set)
PORTAL_SECRET=change-me-before-deploying

# Stripe (Phase 2 payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Form security & throttling
# Optional: customize if needed in code-level constants
# (Current defaults are in-memory per-IP buckets in lib/actions.ts)
